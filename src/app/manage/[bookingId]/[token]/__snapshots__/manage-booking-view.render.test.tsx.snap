exports[`ManageBookingView renders (P2-4 gate) > a booking that does not exist says so 1`] = `"Booking not foundWe couldn't find a booking for this link. It may have been removed.Go home"`;

exports[`ManageBookingView renders (P2-4 gate) > a card awaiting details offers the payment link 1`] = `"Frozen Venue1 Frozen StreetServiceConsultationStaffAlex PractitionerDateWednesday 10 JuneTime14:00StatusBookedAdd your card details to secure this booking. No payment is taken.Add card detailsChange appointmentCancel appointmentPowered by ResNeo"`;

exports[`ManageBookingView renders (P2-4 gate) > a class session shows its summary 1`] = `"Frozen Venue1 Frozen StreetClass bookingReformer Pilates · 2026-06-10 18:30DateWednesday 10 JuneTime14:00Guests1StatusBookedChange sessionCancel bookingPowered by ResNeo"`;

exports[`ManageBookingView renders (P2-4 gate) > a held card states the fee and what would charge it 1`] = `"Frozen Venue1 Frozen StreetServiceConsultationStaffAlex PractitionerDateWednesday 10 JuneTime14:00StatusBookedYour card is securely on file. Frozen Venue may charge a no-show fee of up to £15.00 if you miss this booking or cancel late. Cancel before Mon, 8 Jun 2026, 14:00 to avoid any charge.Change appointmentCancel appointmentPowered by ResNeo"`;

exports[`ManageBookingView renders (P2-4 gate) > a paid deposit is stated with its amount 1`] = `"Frozen Venue1 Frozen StreetServiceConsultationStaffAlex PractitionerDateWednesday 10 JuneTime14:00StatusBookedDeposit paid: £25.00Change appointmentCancel appointmentPowered by ResNeo"`;

exports[`ManageBookingView renders (P2-4 gate) > a resource booking shows the resource 1`] = `"Frozen Venue1 Frozen StreetResource bookingCourt 1 · until 14:30DateWednesday 10 JuneTime14:00Guests1StatusBookedChange slotCancel bookingPowered by ResNeo"`;

exports[`ManageBookingView renders (P2-4 gate) > a table reservation shows guests rather than a service 1`] = `"Frozen Venue1 Frozen StreetDateWednesday 10 JuneTime14:00Guests4StatusBookedModify bookingCancel reservationPowered by ResNeo"`;

exports[`ManageBookingView renders (P2-4 gate) > a used link explains itself and offers a new one 1`] = `"Link already usedThis booking link has already been used and is no longer active.Check your inbox for a more recent email, or contact the venue to resend your booking link.Go home"`;

