exports[`ManageBookingView renders (P2-4 gate) > an appointment shows its service, staff, and the policy copy 1`] = `"Frozen Venue1 Frozen StreetServiceConsultationStaffAlex PractitionerDateWednesday 10 JuneTime14:00StatusBookedChange appointmentCancel appointmentPowered by ResNeo"`;

exports[`ManageBookingView renders (P2-4 gate) > an event ticket shows the event name 1`] = `"Frozen Venue1 Frozen StreetEvent bookingWine TastingDateWednesday 10 JuneTime14:00Guests1StatusBookedNeed to change this event booking?Event tickets can’t be moved to another date online. To change your booking, cancel it below (if the cancellation policy allows a refund) and book the new date, or contact the venue at +44 20 7946 0000.Cancel bookingPowered by ResNeo"`;

exports[`ManageBookingView renders (P2-4 gate) > an expired link explains itself 1`] = `"Link expiredThis booking link has expired for your security.Check your inbox for a more recent email, or contact the venue to resend your booking link.Go home"`;

