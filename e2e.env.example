# Copy values into .env.local for Playwright smoke tests. See Docs/E2E_SMOKE.md

E2E_BASE_URL=http://localhost:3000
E2E_VENUE_SLUG=e2e-smoke-appointments
E2E_VENUE_NAME=E2E Smoke Salon
E2E_SERVICE_NAME=E2E Smoke Consultation
E2E_OPTIONS_SERVICE_NAME=E2E Smoke Options Consultation
E2E_STRIPE_CONNECTED_ACCOUNT_ID=acct_REPLACE_ME
E2E_DEPOSIT_PENCE=1000

# Staff-first fixture (second venue, seeded by the same script). Its slug is
# fixed rather than configurable so it can never be pointed at the venue above.
# Leave unset to skip the staff-first specs.
E2E_STAFF_FIRST_VENUE_SLUG=e2e-smoke-staff-first
E2E_STAFF_FIRST_CALENDAR_A=E2E Alex
E2E_STAFF_FIRST_CALENDAR_B=E2E Bailey
E2E_STAFF_FIRST_SHARED_SERVICE_NAME=E2E Shared Consultation
E2E_STAFF_FIRST_EXCLUSIVE_SERVICE_NAME=E2E Second Calendar Only
E2E_STAFF_FIRST_OPTIONS_SERVICE_NAME=E2E Staff-First Options Consultation
