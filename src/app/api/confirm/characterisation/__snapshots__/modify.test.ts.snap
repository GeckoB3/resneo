        ],
        [
          "returning",
          "id",
        ],
      ],
      "op": "update",
      "payload": {
        "appointment_service_id": null,
        "booking_date": "2026-06-12",
        "booking_end_time": "11:30:00",
        "booking_time": "11:00:00",
        "calendar_id": "cal-new",
        "cancellation_deadline": "2026-06-10T10:00:00.000Z",
        "cancellation_policy_snapshot": {
          "policy": "Full refund if cancelled 48+ hours before appointment start. No refund within 48 hours of the appointment or for no-shows.",
          "refund_window_hours": 48,
        },
        "estimated_end_time": "2026-06-12T11:30:00.000Z",
        "party_size": 1,
        "practitioner_id": null,
        "processing_time_blocks": [],
        "service_item_id": "svc-new",
        "service_variant_id": null,
        "service_variant_name_snapshot": null,
        "updated_at": "2026-06-01T09:00:00.000Z",
      },
      "table": "bookings",
    },
  ],
  "externalCalls": [
    {
      "args": [
        {
          "after": {
            "booking_date": "2026-06-12",
            "booking_time": "11:00",
            "party_size": 1,
          },
          "before": {
            "booking_date": "2026-06-10",
            "booking_time": "14:00",
            "party_size": 1,
          },
          "booking_id": "11111111-1111-4111-8111-111111111111",
          "modification_actor": "guest",
          "venue_id": "22222222-2222-4222-8222-222222222222",
        },
      ],
      "fn": "logBookingModifiedEvent",
      "module": "booking-modified-event",
    },
    {
      "args": [
        {
          "appointmentServiceId": null,
          "bookingDate": "2026-06-12",
          "bookingTime": "11:00:00",
          "context": "online",
          "guestId": "33333333-3333-4333-8333-333333333333",
          "serviceItemId": "svc-new",
          "venueId": "22222222-2222-4222-8222-222222222222",
        },
      ],
      "fn": "enforceBookingCompliance",
      "module": "compliance",
    },
    {
      "args": [
        "guest_self_reschedule",
      ],
      "fn": "assertAppointmentsFeatureEnabled",
      "module": "feature-flags",
    },
    {
      "args": [
        "22222222-2222-4222-8222-222222222222",
      ],
      "fn": "executeBookingModificationGuestNotification",
      "module": "modification-comms",
    },
  ],
  "status": 200,
}
`;

