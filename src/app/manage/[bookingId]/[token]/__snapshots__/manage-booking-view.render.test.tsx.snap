exports[`ManageBookingView renders (P2-4 gate) > a booking that does not exist says so 1`] = `"Booking not foundWe couldn't find a booking for this link. It may have been removed.Go home"`;

exports[`ManageBookingView renders (P2-4 gate) > a card awaiting details offers the payment link 1`] = `"Frozen Venue1 Frozen StreetServiceConsultationStaffAlex PractitionerDateWednesday 10 JuneTime14:00StatusBookedGet directionsAdd your card details to secure this booking. No payment is taken.Add card detailsChange appointmentCancel appointmentAdd to Google CalendarDownload for other calendarsContact the venue+44 20 7946 0000hello@frozen.testPowered by ResNeo"`;

exports[`ManageBookingView renders (P2-4 gate) > a class session shows its summary 1`] = `"Frozen Venue1 Frozen StreetClass bookingReformer Pilates · 2026-06-10 18:30DateWednesday 10 JuneTime14:00Guests1StatusBookedGet directionsChange sessionCancel bookingAdd to Google CalendarDownload for other calendarsContact the venue+44 20 7946 0000hello@frozen.testPowered by ResNeo"`;

exports[`ManageBookingView renders (P2-4 gate) > a held card states the fee and what would charge it 1`] = `"Frozen Venue1 Frozen StreetServiceConsultationStaffAlex PractitionerDateWednesday 10 JuneTime14:00StatusBookedGet directionsYour card is securely on file. Frozen Venue may charge a no-show fee of up to £15.00 if you miss this booking or cancel late. Cancel before Mon, 8 Jun 2026, 14:00 to avoid any charge.Change appointmentCancel appointmentAdd to Google CalendarDownload for other calendarsContact the venue+44 20 7946 0000hello@frozen.testPowered by ResNeo"`;

exports[`ManageBookingView renders (P2-4 gate) > a paid deposit is stated with its amount 1`] = `"Frozen Venue1 Frozen StreetServiceConsultationStaffAlex PractitionerDateWednesday 10 JuneTime14:00StatusBookedGet directionsDeposit paid: £25.00Change appointmentCancel appointmentAdd to Google CalendarDownload for other calendarsContact the venue+44 20 7946 0000hello@frozen.testPowered by ResNeo"`;

