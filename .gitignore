# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/blob-report/
/playwright/.cache/
/test-results/

# next.js
/.next/
/.next-preview/
/.next-preview-iso/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the E2E template, which carries no secrets and is the only record of
# which variables the smoke suite needs. The real .env.e2e stays ignored above.
!.env.e2e.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# Supabase CLI local cache
supabase/.temp/

# tooling / local
scripts/output/
# generated seed output (scratch data, not source)
scripts/seed-plus1-demo-output.json
# local agent / IDE
.claude/

# eslint output captures (not source)
eslint-output.txt
eslint2.txt

# editor / merge backups
*.orig

# local log exports (may contain PII — never commit)
Docs/supabase-*-logs-*.csv*

# generated marketing assets (video renders, thumbnails), not source
/marketing/

# Playwright saved sessions: a live staging session cookie, never commit.
/e2e/.auth/
