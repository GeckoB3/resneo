# E2E smoke test configuration.
#
# Copy to `.env.e2e` and fill in. `playwright.config.ts` and `e2e/global-setup.ts`
# both load `.env.e2e` from the repo root; it is gitignored and must never be committed.
# See Docs/E2E_SMOKE.md.
#
# The same variables are the Actions secrets the `e2e-smoke` CI job needs. That job is
# additionally gated on the repo variable RUN_E2E_SMOKE=true (.github/workflows/ci.yml),
# so setting the secrets alone will not make it run.

# --- Required. global-setup throws if any of these are missing once a venue slug is set.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signs the `?hmac=` manage and confirm links the specs build via e2e/helpers/manage-link.ts.
# Must match the value the app under test is running with, or every HMAC link 403s.
PAYMENT_TOKEN_SECRET=

# --- Fixture venue. Without E2E_VENUE_SLUG the appointment specs skip rather than fail.
# Produced by `node scripts/seed-e2e-smoke-venue.mjs`.
E2E_VENUE_SLUG=
E2E_VENUE_NAME=E2E Smoke Salon
E2E_SERVICE_NAME=E2E Smoke Consultation
E2E_OPTIONS_SERVICE_NAME=E2E Smoke Options Consultation

# --- Stripe Connect on the fixture venue. Paid-booking specs fail without it
# (global-setup warns rather than throws, so the failure surfaces mid-spec).
E2E_STRIPE_CONNECTED_ACCOUNT_ID=
E2E_DEPOSIT_PENCE=
E2E_CARD_HOLD_SERVICE_NAME=
E2E_CARD_HOLD_FEE_PENCE=

# --- Staff-first fixture. Optional: its specs skip unless the slug is set.
E2E_STAFF_FIRST_VENUE_SLUG=
E2E_STAFF_FIRST_CALENDAR_A=E2E Alex
E2E_STAFF_FIRST_CALENDAR_B=E2E Bailey
E2E_STAFF_FIRST_SHARED_SERVICE_NAME=E2E Shared Consultation
E2E_STAFF_FIRST_EXCLUSIVE_SERVICE_NAME=E2E Second Calendar Only
E2E_STAFF_FIRST_OPTIONS_SERVICE_NAME=E2E Staff-First Options Consultation

# --- Target. Defaults to http://localhost:3000.
# E2E_BASE_URL=
# Set to 1 to test against an already-running server instead of having Playwright start one.
# E2E_SKIP_WEB_SERVER=
