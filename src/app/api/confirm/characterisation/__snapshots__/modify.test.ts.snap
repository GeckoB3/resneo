exports[`POST /api/confirm - action=modify + cross-cutting (P0-9, 21 rows) > row 4: unified appointment writes calendar/service_item and NULLS the legacy pair 1`] = `
{
  "body": {
    "appointment_service_id": "svc-new",
    "booking_date": "2026-06-12",
    "booking_time": "11:00",
